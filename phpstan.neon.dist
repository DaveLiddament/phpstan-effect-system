includes:
	- extension.neon

parameters:
	level: max
	paths:
		- src
		- tests
	excludePaths:
		- tests/Rules/data
		- tests/EndToEnd/fixture
	ignoreErrors:
		# Detecting first-class-callable virtual nodes and distinguishing
		# method from function reflections requires instanceof on PHPStan
		# classes; the BC risk is accepted.
		- identifier: phpstanApi.instanceofAssumption
