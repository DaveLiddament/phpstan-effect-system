includes:
	- ../../../extension.neon

parameters:
	effects:
		stubs:
			- { function: 'file_get_contents', effects: ['io'] }
			- { method: 'EffectTest\StubVendor\Mailer::send', effects: ['smtp'] }
		# Takes precedence over ConventionInferrer for file_put_contents(), so
		# the messages show that both are wired.
		sources:
			- { functionPattern: 'file_put_*', effects: ['io'] }
		rules:
			# exclude is optional, and when used it must not be reported as
			# stale: Service::fetch() matches the rule.
			- { classPattern: 'EffectTest\Stubs\Service', methodPattern: 'fetch', effectFree: ['io'], exclude: ['EffectTest\Stubs\Service'] }
			- { classPattern: 'EffectTest\Stubs\NoSuchClass', methodPattern: '*', effectFree: ['io'] }
		allowedEffects: ['slow', 'io', 'http', 'smtp', 'state']

services:
	-
		class: DaveLiddament\PhpstanEffectSystem\Tests\Rules\Inference\ConventionInferrer
		tags:
			- effects.inferrer
